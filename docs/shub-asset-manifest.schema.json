{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shub.local/schema/shub-asset-manifest.schema.json",
  "title": "SHUB Derived Asset Manifest",
  "description": "Normalized internal manifest derived from SKILL.md packages after SHUB parses frontmatter and package structure. This is not the authoring format.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "category",
    "version",
    "name",
    "description",
    "sourceSkill",
    "entry",
    "runtime"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "shub.asset/v1alpha1"
    },
    "id": {
      "type": "string",
      "description": "Canonical namespace/name identifier.",
      "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)+$"
    },
    "category": {
      "type": "string",
      "enum": [
        "prompt",
        "agent",
        "mcp"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "allowedTools": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "sourceSkill": {
      "$ref": "#/$defs/sourceSkill"
    },
    "entry": {
      "$ref": "#/$defs/entry"
    },
    "runtime": {
      "$ref": "#/$defs/runtime"
    },
    "exports": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/export"
      },
      "default": []
    },
    "dependencies": {
      "$ref": "#/$defs/dependencies"
    },
    "hooks": {
      "$ref": "#/$defs/hooks"
    },
    "metadata": {
      "type": "object",
      "description": "Arbitrary non-executable metadata used for search and display.",
      "additionalProperties": true
    }
  },
  "$defs": {
    "sourceSkill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bodyFormat"
      ],
      "properties": {
        "path": {
          "type": "string",
          "const": "SKILL.md"
        },
        "bodyFormat": {
          "type": "string",
          "enum": [
            "markdown",
            "text"
          ],
          "default": "markdown"
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "skill-body",
            "command",
            "python-module",
            "node-module",
            "binary",
            "mcp-config"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "none",
            "python",
            "node",
            "binary"
          ]
        },
        "version": {
          "type": "string"
        },
        "install": {
          "$ref": "#/$defs/install"
        }
      }
    },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy"
      ],
      "properties": {
        "strategy": {
          "type": "string",
          "enum": [
            "none",
            "uv",
            "pip",
            "npm",
            "pnpm",
            "yarn",
            "binary"
          ]
        },
        "path": {
          "type": "string"
        },
        "lockfile": {
          "type": "string"
        }
      }
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "mode",
        "source"
      ],
      "properties": {
        "target": {
          "type": "string",
          "enum": [
            "codex",
            "claude-code",
            "cursor",
            "aider",
            "skills"
          ]
        },
        "mode": {
          "type": "string",
          "enum": [
            "prompt-file",
            "rules-file",
            "mcp-config",
            "skill-dir"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "targetPath": {
          "type": "string"
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prompts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dependencyRef"
          },
          "default": []
        },
        "skills": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dependencyRef"
          },
          "default": []
        },
        "mcps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dependencyRef"
          },
          "default": []
        },
        "agents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dependencyRef"
          },
          "default": []
        }
      }
    },
    "dependencyRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)+$"
        },
        "version": {
          "type": "string",
          "not": {
            "const": "latest"
          }
        },
        "category": {
          "type": "string",
          "enum": [
            "prompt",
            "agent",
            "mcp"
          ]
        }
      }
    },
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "post_install": {
          "$ref": "#/$defs/command"
        },
        "post_pull": {
          "$ref": "#/$defs/command"
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run"
      ],
      "properties": {
        "run": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
